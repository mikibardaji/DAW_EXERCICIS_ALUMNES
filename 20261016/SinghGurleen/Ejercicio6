package classe.Ejercicio6;

import java.util.Scanner;

/**
 *
 * @author gurleen
 */
public class Ejercicio6 {

      public static void main(String[] args) {
        Scanner teclado = new Scanner(System.in);

        int num;
        boolean negativo = false;

        for (int i = 1; i <= 10; i++) 
        {
            System.out.println("Introduce un numero no nulo:");
            num = teclado.nextInt();

            while (num == 0) {
                System.out.println("No puede ser 0. Introduce otro numero:");
                num = teclado.nextInt();
            }   

        if (num < 0) 
        {
             negativo = true;
            System.out.println("Es numero un negativo");
        } 
        else 
        {
            System.out.println("No es numbero negativo");
        }
        }
      
}

}
