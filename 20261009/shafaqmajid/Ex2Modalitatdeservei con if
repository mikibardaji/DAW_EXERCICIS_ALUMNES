package ex2modalitatdeservei;

import java.util.Scanner;

/**
 *
 * @author Usuario
 */
public class Ex2Modalitatdeservei {

    /**
     * @param args the command line arguments
     */
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
       // Variables
        String modalitat, enllac, lloc;

        // Mostrar
        System.out.print("Introdueix la modalitat (Online/Presencial): ");

        // Esperar
        modalitat = sc.nextLine();

        // Calcular / comprovar
        if (modalitat.equalsIgnoreCase("Online")) 
        {

            // Mostrar
            System.out.print("Introdueix l'enllac de Discord/Meet: ");

            // Esperar
            enllac = sc.nextLine();

            // Mostrar
            System.out.println("Servei configurat. Enllac desat.");

        } 
        else if (modalitat.equalsIgnoreCase("Presencial")) 
        
        
        {

            // Mostrar
            System.out.print("Introdueix l'aula o lloc de trobada: ");

            // Esperar
            lloc = sc.nextLine();

            // Mostrar
            System.out.println("Servei configurat. Punt de trobada desat.");

        }
        else 
        {

            // Mostrar
            System.out.println("Modalitat no valida.");
        }
    }
}
    
    
    
    
    

