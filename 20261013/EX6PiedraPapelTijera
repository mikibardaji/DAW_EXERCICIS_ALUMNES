package ex6pedrapapertisora;

import java.util.Random;
import java.util.Scanner;

/**
 *
 * @author kande
 */
public class EX6PedraPaperTisora {

    /**
     * @param args the command line arguments
     */
    public static void main(String[] args) {
        // TODO code application logic here

        Scanner scanner = new Scanner(System.in);
        Random random = new Random();
        String nomUsuario, text, nomOrdenador;
        int maquina, jugador;
        char jugada;

// Pedimos la jugada al usuario
        System.out.print("Introduce tu jugada (S: Piedra, P: Papel, T: Tijera): ");
        text = scanner.next();
        jugada = text.charAt(0);

// Comprobamos la jugada elegida
        if (jugada == 'S') {
            jugador = 0;
            nomUsuario = "Piedra";
        } else if (jugada == 'P') {
            jugador = 1;
            nomUsuario = "Papel";
        } else {
            jugador = 2;
            nomUsuario = "Tijera";
        }

// Generamos la jugada aleatoria de la máquina
        maquina = random.nextInt(3);

        if (maquina == 0) {
            nomOrdenador = "Piedra";
        } else if (maquina == 1) {
            nomOrdenador = "Papel";
        } else {
            maquina = 2;
            nomOrdenador = "Tijera";
        }

// Enseñamos las jugadas elegidas
        System.out.println("Has elegido: " + nomUsuario);
        System.out.println("La máquina ha elegido: " + nomOrdenador);

// Comprobamos quién ha ganado
        if (jugador == maquina) {
            System.out.println("Resultado: ¡Habéis empatado!");
        } else if ((jugador == 0 && maquina == 2) || (jugador == 1 && maquina == 0) || (jugador == 2 && maquina == 1)) {
            System.out.println("Resultado: ¡Felicidades, has ganado!");
        } else {
            System.out.println("Resultado: ¡Ha ganado la máquina!");
        }
    }
}
